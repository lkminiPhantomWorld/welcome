      "role": "generic_welcome_page",
      "state": "verified"
    },
    {
      "path": "mini/index.html",
      "role": "ai_unique_entry_reader_gateway",
      "state": "verified"
    },
    {
      "path": "ui/shrine/index.html",
      "role": "independent_public_projection",
      "state": "verified"
    },
    {
      "path": "PORTAL_MANIFEST.json",
      "role": "manifest",
      "state": "verified"
    },
    {
      "path": "PORTAL_LOCATOR.json",
      "role": "locator",
      "state": "verified"
    },
    {
      "path": "PORTAL_REVERSECHAIN.json",
      "role": "reverse_chain",
      "state": "verified"
    },
    {
      "path": "PORTAL_SHA256SUMS",
      "role": "hash_index",
      "state": "verified"
    },
    {
      "path": "tools/verify_portal.py",
      "role": "fail_closed_verifier",
      "state": "verified"
    },
    {
      "path": ".github/workflows/deploy-pages.yml",
      "role": "deployment",
      "state": "verified"
    }
  ],
  "private_device_coordinates": "excluded_from_public_projection"
}
