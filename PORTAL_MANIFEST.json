    "ai_entry_role": "ai_unique_entry_reader_gateway",
    "ai_entry_count": 1,
    "root_protocol": "LKMINI://",
    "validation_policy": "fail_closed_all_checks_required",
    "on_failure": "reject_mount_and_deny_entry"
  },
  "open_source_separation": "one_project_one_independent_repository",
