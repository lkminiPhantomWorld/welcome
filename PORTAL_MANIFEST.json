{
  "name": "🥳通用歡迎頁｜PublicWelcomeManifest",
  "type": "public_projection_manifest",
  "system": "🥃老K系統",
  "root_node": "🧩LKMINI",
  "root_protocol": "LKMINI://",
  "A_EQUALS_A": true,
  "entry_definition": {
    "welcome_page": "index.html",
