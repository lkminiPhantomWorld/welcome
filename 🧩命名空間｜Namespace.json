{
  "object_type": "lk_global_namespace",
  "version": "2.0",
  "name": "🧩命名空間｜Namespace",
  "root": "🧩LKMINI",
  "system_count": 1,
  "namespace_role": "GLOBAL_ROOT",
  "axiom": "A=A",
  "purpose": "為多人、多角色、多應用、多膠囊與多投影提供同一套可解析、可追溯、可擴充的命名根。",
  "identity_binding": {
    "readme": "README.md",
    "state": "SYSTEM_STATE.md",
    "lineage": "LINEAGE.md"
  },
  "address_model": {
    "canonical_path": "namespace://<realm>/<owner>/<domain>/<identity>/<projection>",
    "human_name": "Emoji＋中文名稱｜EnglishKey",
    "display_name": "Emoji＋中文名稱",
    "stable_key": "EnglishKey",
    "identity_id": "immutable",
    "owner_scope": "person | team | organization | public",
    "visibility": "public | shared | private | hidden"
  },
  "namespace_layers": {
    "realm": "世界或文明範圍",
    "owner": "人、團隊、組織或公共持有人",
    "domain": "能力、資料、角色、工具、膠囊、投影、任務或其他領域",
    "identity": "唯一且不可因顯示名稱改變的正式身分",
    "projection": "不同格式、裝置、語言與應用的顯影"
  },
  "subnamespaces": [
    {
      "name": "🪞膠囊命名空間｜CapsuleNamespace",
      "path": "🪞膠囊命名空間｜CapsuleNamespace.json",
      "role": "CAPSULE_DOMAIN"
    }
  ],
  "multi_user_rules": {
    "multiple_people_allowed": true,
    "same_display_name_allowed": true,
    "same_identity_id_allowed": false,
    "owner_scope_required": true,
    "cross_owner_collision_resolution": "owner_scope + identity_id",
    "language_projection_allowed": true,
    "display_name_change_preserves_identity": true
  },
  "semantic_rules": {
    "name_is_semantic_code": true,
    "command_is_separate": true,
    "state_is_separate": true,
    "projection_is_separate": true,
    "rename_requires_reference_check": true,
    "rename_requires_locator_update": true,
    "rename_requires_manifest_update": true,
    "rename_requires_mount_update": true,
    "rename_requires_reverse_chain_update": true
  },
  "governance": {
    "second_system_allowed": false,
    "parallel_root_allowed": false,
    "subnamespace_allowed": true,
    "subnamespace_must_return_to_root": true,
    "global_collision_log_required": true,
    "lineage_required": true
  },
  "return_to": "🧩LKMINI"
}
